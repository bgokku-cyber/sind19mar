PORT=3000
NODE_ENV=development

# Genera un secreto local con: openssl rand -base64 48
# Nunca reutilices este valor en producción ni lo subas al repositorio.
AUTH_JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_bytes

# Solo para desarrollo local. Si cambias estos valores, mantenlos sincronizados
# con DATABASE_URL y con las variables usadas por docker-compose.yml.
POSTGRES_DB=sind19mar_dev
POSTGRES_USER=sind19mar
POSTGRES_PASSWORD=local_dev_only_change_me

DATABASE_URL="postgresql://sind19mar:local_dev_only_change_me@localhost:5432/sind19mar_dev?schema=public"
