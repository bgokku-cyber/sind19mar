PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sind19mar?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
CORS_ORIGINS="http://localhost:3001"
# Solo para crear el primer administrador con el comando de seed:
ADMIN_PHONE="59170000000"
ADMIN_PASSWORD="replace-with-at-least-14-characters"
ADMIN_NAME="Administrador principal"
CURRENCY=BOB

# Configuración central del mapa (La Paz como zona inicial)
MAP_CITY="La Paz"
MAP_COUNTRY="Bolivia"
MAP_CENTER_LATITUDE="-16.5"
MAP_CENTER_LONGITUDE="-68.15"
MAP_DEFAULT_ZOOM="12"
MAP_COVERAGE_RADIUS_KM="25"
MAP_PROVIDER="openstreetmap"
# Debe usar únicamente los placeholders {z}, {x} y {y}; para producción configura un proveedor de teselas contratado o propio.
MAP_TILE_URL_TEMPLATE="https://tile.openstreetmap.org/{z}/{x}/{y}.png"

# Motor tarifario (configurar sólo tras aprobación de las tarifas del sindicato).
# No hay valores predeterminados intencionales.
# FARE_BASE_BOB=
# FARE_PER_KM_BOB=
# FARE_MINIMUM_BOB=

# Proveedor de rutas (OSRM API compatible). El servidor público es sólo para pruebas/piloto de bajo volumen.
ROUTING_PROVIDER=osrm
ROUTING_BASE_URL=https://router.project-osrm.org
